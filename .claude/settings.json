{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "ask": [
      "Bash(.agents/scripts/commit.sh *)",
      "Bash(git push *)"
    ],
    "deny": [
      "Bash(git commit *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
