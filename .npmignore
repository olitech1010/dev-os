# Dev-OS npm package defense-in-depth
# The package.json "files" allowlist is the primary gate; this is a safety net.

# Personal workspace state (never ship)
docs/CURRENT_STATE.md
docs/TASK_BOARD.md
docs/LESSONS.md
docs/2026-*.md
docs/FIELD_REPORT_*.md
docs/PLAN_*.md
docs/superpowers/

# Runtime state
.agents/memory/context.json
.agents/memory/session.json
.agents/memory/sdlc-state.json
.agents/telemetry/*.jsonl

# Eval run history and the repo's own scorecard
.agents/evals/reports/
.agents/evals/reports/latest-scorecard.json
.agents/evals/reports/scorecard-*.json

# The Dev-OS repo's own install manifest (targets get theirs from devos init)
.agents/manifest.json

# Backups and local tool binaries
.agents/_backup/
.agents/bin/
# Python bytecode (never ship)
__pycache__/
*.pyc

# Build output and the git-only marketplace catalog
/dist/
/.claude-plugin/
